# Option 1 (recommandée) : EmailJS — https://dashboard.emailjs.com
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxx

# Option 2 : envoi direct par Gmail (utilisé seulement si EmailJS n'est pas configuré)
# Compte Gmail qui ENVOIE le mail (peut être chalfive10@gmail.com lui-même)
SMTP_USER=chalfive10@gmail.com
# Mot de passe d'application Google (16 caractères) : https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx xxxx xxxx xxxx
# Destinataire des réponses
MAIL_TO=chalfive10@gmail.com
